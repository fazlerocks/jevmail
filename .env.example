# NextAuth Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=

# Google Cloud OAuth Web Client Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: Restrict access to a specific email address (recommended for security)
ALLOWED_EMAIL=

# Vercel AI Gateway Key
AI_GATEWAY_API_KEY=

# Optional tuning
# SYNC_LIMIT=20
# FETCH_MORE_LIMIT=100
# GMAIL_RATE_PER_MIN=100
# JEV_CONCURRENCY=1
# JEV_BURST=5
